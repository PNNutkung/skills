{
  "version": 1,
  "rules": {
    "hook-readflags": {
      "hooks/retro-collect.mjs": 1
    },
    "path-relative": {
      "hooks/dod-adr-sync.mjs": 1,
      "hooks/qa-guard.mjs": 1,
      "rules/checks/run-tests.mjs": 2,
      "rules/checks/test-time.mjs": 1,
      "skills/qa-sweep/run.mjs": 1,
      "skills/retro/adapters.mjs": 1,
      "skills/verify/verify.mjs": 2,
      "skills/zero-trust-review/proofcheck.test.mjs": 1
    },
    "plugin-version-pin": {},
    "spawn-async-timeout": {},
    "test-serial": {}
  },
  "patterns": {
    "hook-readflags": {
      "regex": "readFlags\\(",
      "glob": "hooks/*.mjs"
    },
    "path-relative": {
      "regex": "\\brelative\\(",
      "glob": "**/*.mjs"
    },
    "plugin-version-pin": {
      "regex": "version,\\s*['\"]\\d+\\.\\d+\\.\\d+['\"]",
      "glob": "**/*.test.mjs"
    },
    "spawn-async-timeout": {
      "regex": "\\bspawn\\([^;]*\\btimeout\\s*:",
      "glob": "**/*.mjs"
    },
    "test-serial": {
      "regex": "test-concurrency[= ]1\\b|concurrency:\\s*(1|false)\\b",
      "glob": "**/*.{mjs,yml}"
    }
  },
  "accepted": []
}
