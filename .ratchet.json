{
  "version": 1,
  "rules": {
    "cross-skill-import": {
      "skills/definition-of-done/adr-e2e.test.mjs": 2,
      "skills/definition-of-done/dodwhy.test.mjs": 1,
      "skills/definition-of-done/e2e.test.mjs": 1,
      "skills/definition-of-done/integration.test.mjs": 2,
      "skills/definition-of-done/why.e2e.test.mjs": 1,
      "skills/paired-agent-tdd/dodfile.test.mjs": 1,
      "skills/paired-agent-tdd/e2e.fast.test.mjs": 2,
      "skills/paired-agent-tdd/e2e.test.mjs": 2,
      "skills/paired-agent-tdd/test-e2e-speed.mjs": 2,
      "skills/qa-sweep/dodfile.test.mjs": 1
    },
    "hook-readflags": {
      "hooks/retro-collect.mjs": 1
    },
    "path-relative": {
      "hooks/dod-adr-sync.mjs": 1,
      "hooks/qa-guard.mjs": 1,
      "rules/checks/run-tests.mjs": 2,
      "rules/checks/test-time.mjs": 1,
      "skills/qa-sweep/run.mjs": 1,
      "skills/retro/adapters.mjs": 1,
      "skills/verify/verify.mjs": 2,
      "skills/zero-trust-review/proofcheck.test.mjs": 1
    },
    "plugin-version-pin": {},
    "spawn-async-timeout": {},
    "test-serial": {}
  },
  "patterns": {
    "cross-skill-import": {
      "regex": "^\\s*import\\s[^;]*?from\\s+['\"]\\.\\./(?!\\.\\.)[a-z][a-z0-9-]*/",
      "glob": "skills/*/*.mjs"
    },
    "hook-readflags": {
      "regex": "readFlags\\(",
      "glob": "hooks/*.mjs"
    },
    "path-relative": {
      "regex": "\\brelative\\(",
      "glob": "**/*.mjs"
    },
    "plugin-version-pin": {
      "regex": "version,\\s*['\"]\\d+\\.\\d+\\.\\d+['\"]",
      "glob": "**/*.test.mjs"
    },
    "spawn-async-timeout": {
      "regex": "\\bspawn\\([^;]*\\btimeout\\s*:",
      "glob": "**/*.mjs"
    },
    "test-serial": {
      "regex": "test-concurrency[= ]1\\b|concurrency:\\s*(1|false)\\b",
      "glob": "**/*.{mjs,yml}"
    }
  },
  "accepted": []
}
